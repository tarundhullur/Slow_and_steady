# Ollama must run on this computer; remote model endpoints are rejected.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Optional: defaults to ~/.lazyflow-ai/lazyflow.sqlite3
# LAZYFLOW_DB_PATH=/absolute/path/to/lazyflow.sqlite3

# Optional: set a custom API URL in the frontend environment.
# VITE_API_URL=http://127.0.0.1:8000
